{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/danny-y1/linuxlab-wine-apps/schema/linuxlab-apps.schema.json",
  "type": "object",
  "required": ["schema_version", "owner", "applications"],
  "properties": {
    "schema_version": {"const": 1},
    "owner": {"const": "danny-y1"},
    "applications": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "aliases", "version", "source_class", "trust_level", "source_page", "repository", "ref", "delivery", "parts", "artifact_kind", "architecture", "size_bytes", "sha256"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "aliases": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "version": {"type": "string", "minLength": 1},
          "source_class": {"enum": ["official", "store", "community", "portable", "repack", "crack", "unknown"]},
          "trust_level": {"const": "account_trusted"},
          "source_page": {"type": "string", "pattern": "^https://github\\.com/danny-y1/"},
          "repository": {"type": "string", "minLength": 1},
          "ref": {"type": "string", "minLength": 1},
          "delivery": {"const": "github_parts"},
          "parts": {
            "type": "array",
            "minItems": 1,
            "maxItems": 256,
            "items": {
              "type": "object",
              "required": ["path", "size_bytes", "sha256"],
              "properties": {
                "path": {"type": "string", "minLength": 1},
                "size_bytes": {"type": "integer", "minimum": 1, "maximum": 104857600},
                "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
              },
              "additionalProperties": false
            }
          },
          "artifact_kind": {"enum": ["windows_pe", "windows_msi"]},
          "architecture": {"enum": ["x86", "x64", "unknown"]},
          "size_bytes": {"type": "integer", "minimum": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "authenticode": {"type": "string"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}